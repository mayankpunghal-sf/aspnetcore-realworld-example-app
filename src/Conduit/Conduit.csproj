<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    CA1304/CA1311/CA1862 fire on string.ToLower() inside EF Core LINQ expressions, but these
    are translated to SQL LOWER() (not executed in .NET) so no current-culture dependency
    exists; ToLowerInvariant() is deliberately not used because EF Core cannot translate it
    to SQL on any provider. Comparison semantics are governed by database collation.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1304;CA1311;CA1862</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
</Project>
