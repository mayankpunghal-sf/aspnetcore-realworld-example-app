{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb_SqlServer": "Server=<host>,1433;Database=<database>;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;",
    "AppDb_PostgreSql": "Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Search Path=public;"
  }
}
